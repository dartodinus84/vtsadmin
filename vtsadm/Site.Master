                        </div>
                        <!-- /.form-group -->
                        <%--</form>--%>
                    </div>
                    <!-- /.tab-pane -->
                </div>
                </aside>
                <div class="control-sidebar-bg"></div>
            </asp:PlaceHolder>
        </div>
        <div class="modal fade" id="modal-logout">
            <div class="modal-dialog modal-sm">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title">Sign Out</h4>
                    </div>
                    <div class="modal-body">
                        <h6 class="modal-title">Are you sure want sign out ?</h6>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" runat="server" onclick="$('#modal-logout').modal('hide');" onserverclick="cmdYesSignOut_ServerClick" id="cmdYesSignOut">Yes</button>
                        <button type="button" class="btn btn-primary" onclick="$('#modal-logout').modal('hide');">No</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="modal-changepass">
            <div class="modal-dialog modal-sm">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title">Change Password</h4>
                    </div>
                    <div class="modal-body">
                        <div class="form-group form-group-sm">
                            <label>Old Password</label>
                            <input type="password" id="txtOldPass" runat="server" class="form-control" placeholder="Old Password ..." />
                        </div>
                        <div class="form-group form-group-sm">
                            <label>New Password</label>
                            <input type="password" id="txtNewPass" runat="server" class="form-control" placeholder="New Password ..." />
                        </div>
                        <div class="form-group form-group-sm">
                            <label>Confirm Password</label>
                            <input type="password" id="txtConfPass" runat="server" class="form-control" placeholder="Confirm Password ..." />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" runat="server" onserverclick="CmdYesChangePass_ServerClick" id="CmdYesChangePass">Yes</button>
                        <button type="button" class="btn btn-primary" onclick="$('#modal-changepass').modal('hide');">No</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal modal-open fade" id="modal-messagebox">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title">Info Box</h4>
                    </div>
                    <div class="modal-body">
                        <div class="form-group form-group-sm" id="div_comment" runat="server">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default pull-left" data-dismiss="modal">Close</button>
                    </div>
                </div>
                <!-- /.modal-content -->
            </div>
            <!-- /.modal-dialog -->
        </div>

        <!-- ./wrapper -->


        <!-- jQuery 3 -->
        <!-- Bootstrap 3.3.7 -->
        <script src="Content/bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
        <!-- Select2 -->
        <script src="Content/bower_components/select2/dist/js/select2.full.min.js"></script>
        <!-- DataTables -->
        <script src="Content/bower_components/datatables.net/js/jquery.dataTables.min.js"></script>
        <script src="Content/bower_components/datatables.net-bs/js/dataTables.bootstrap.min.js"></script>
        <!-- BootstrapTables -->
        <script src="Content/bower_components/bootstrap-table/js/bootstrap-table.min.js"></script>
        <script src="Content/bower_components/bootstrap-table/js/bootstrap-table-group-by.min.js"></script>
        <script src="Content/bower_components/bootstrap-table/js/bootstrap-table-export.min.js"></script>
        <script src="Content/bower_components/bootstrap-table/js/tableExport.min.js"></script>
        <!-- InputMask -->
        <script src="Content/plugins/input-mask/jquery.inputmask.js"></script>
        <script src="Content/plugins/input-mask/jquery.inputmask.date.extensions.js"></script>
