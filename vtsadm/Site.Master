    </form>
    <script type="text/javascript">
        $(document).ready(function () {

            //enabled filter side bar
            //$('#sidebar-form').on('submit', function (e) {
            //    e.preventDefault();
            //});

               


            $('.sidebar-menu li.active').data('lte.pushmenu.active', true);

            //$('#txtMenuSearch').on('keyup', function () {
            $('#CmdMenuSearch').on('click', function () {
                var term = $('#txtMenuSearch').val().trim();

                if (term.length === 0) {
                    $('.sidebar-menu li').each(function () {
                        $(this).show(0);
                        $(this).removeClass('active');
                        if ($(this).data('lte.pushmenu.active')) {
                            $(this).addClass('active');
                        }
                    });
                    return;
                }

                $('.sidebar-menu li').each(function () {
                    if ($(this).text().toLowerCase().indexOf(term.toLowerCase()) === -1) {
                        $(this).hide(0);
                        $(this).removeClass('pushmenu-search-found', false);

                        if ($(this).is('.treeview')) {
                            $(this).removeClass('active');
                        }
                    } else {
                        $(this).show(0);
                        $(this).addClass('pushmenu-search-found');

                        if ($(this).is('.treeview')) {
                            $(this).addClass('active');
                        }

                        var parent = $(this).parents('li').first();
                        if (parent.is('.treeview')) {
                            parent.show(0);
                        }
                    }

                    if ($(this).is('.header')) {
                        $(this).show();
                    }
                });

                $('.sidebar-menu li.pushmenu-search-found.treeview').each(function () {
                    $(this).find('.pushmenu-search-found').show(0);
                });
            });



            //Initialize Select2 Elements
            $('.select2').select2();

            if (window.screen.width > 720) {
                $("#topbar").hide();
                $("#navbar").hide();
            } else {
                $("#topbar").show();
                $("#navbar").show();
            }
            $(document).trigger("resize");
        });
        function logout_click() {
            $('#modal-logout').modal('show');
        }
        function changepass_click() {
            $('#modal-changepass').modal('show');
        }
        function home_click() {
            document.location.href = '/dashboard.aspx';
        }
        function position_click() {
            document.location.href = '/vehicle_position.aspx';
        }

        var isExists = document.getElementById('div_comment').innerHTML;
        if (isExists != '') {
            //window.setTimeout(function () { $('.alert').fadeTo(500, 0).slideUp(500, function () { $(this).remove(); }); }, 2000)
            $('#modal-messagebox').modal('show');
        }

        function showOverlay() {
            $("#overlay").fadeIn(300);
        }
    </script>

</body>

</html>
