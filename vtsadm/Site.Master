                     <ProgressTemplate> 
                         <asp:Image ID="Image1" runat="server" ImageUrl="~/Content/ajax-loader.gif"/>  
                     </ProgressTemplate>
                 </asp:UpdateProgress>--%>
            </div>
            <!-- /.content-wrapper -->
            <asp:PlaceHolder ID="phLegacyFooter" runat="server">
                <footer class="main-footer" style="height: 50px;">
                    <div class="pull-right hidden-xs">
                        <b>Version</b> 1.0.0
                    </div>
                    <strong>Copyright &copy; 2018 <a href="dashboard.aspx">EasyGo Indonesia</a>.</strong> All rights reserved.
                </footer>

                <!-- Control Sidebar -->
                <aside class="control-sidebar control-sidebar-dark">
                <!-- Create the tabs -->
                <ul class="nav nav-tabs nav-justified control-sidebar-tabs">
                    <li><a href="#control-sidebar-home-tab" data-toggle="tab"><i class="fa fa-home"></i></a></li>
                    <li><a href="#control-sidebar-settings-tab" data-toggle="tab"><i class="fa fa-gear"></i></a></li>
                </ul>
